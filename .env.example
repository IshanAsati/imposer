# Vercel Blob — default production storage.
# Create a private Blob store in your Vercel project (Storage → Blob) and connect
# it; Vercel injects the token automatically. Leave blank for local in-memory rooms.
BLOB_READ_WRITE_TOKEN=""
BLOB_STORE_ID=""

# Optional: Upstash Redis, used instead of Blob when both values are present.
# Create a database at https://console.upstash.com/redis and copy the REST values.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional aliases. Vercel's Redis/KV integrations sometimes expose these names
# instead of the UPSTASH_* pair. Used only when the UPSTASH_* values are absent.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# Canonical URL used for metadata and Open Graph links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
